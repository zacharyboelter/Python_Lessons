print('Grocery List Program')
print('Type "exit" to quit\n\n')

grocery_list = []
user_input = ''
while user_input.lower() != 'exit':
    user_input = input('Enter next item to purchase, type "exit" to finish: ')
    if user_input.lower() != 'exit':
       if user_input not in grocery_list:
           grocery_list.append(user_input)
print(f'\nMy list contains {len(grocery_list)} items.\n')

count = 1
for item in grocery_list:
    print(f'{count}. {item}')
    count += 1

print()